<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="320" prefWidth="350" spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.highdt.inversionees.magdezis.controller.LoginController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Iniciar Sesión" />

    <TextField fx:id="txtUsuario" promptText="Usuario" />
    <PasswordField fx:id="txtPassword" promptText="Contraseña" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleLogin" prefWidth="120" text="Ingresar" />
        <Button onAction="#handleIrARegistro" prefWidth="120" text="Registrarse" />
    </HBox>

    <Label fx:id="lblMensaje" />

</VBox>